{
  "name": "pzz-cms",
  "type": "module",
  "version": "0.1.0",
  "description": "A light, MDX-first CMS built on Astro and Cloudflare Workers.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "e2e": "playwright test",
    "migrate": "bun scripts/migrate.ts",
    "parity": "bun scripts/parity.ts",
    "check": "biome check . && astro check && vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,md}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@iconify-json/heroicons-solid": "^1.2.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdxeditor/editor": "^4.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.3",
    "astro-icon": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "sharp": "^0.35.5",
    "typescript": "6",
    "vitest": "^5.0.3",
    "wrangler": "^4.107.0"
  }
}
