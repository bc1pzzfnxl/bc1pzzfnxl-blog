---
import { env } from "cloudflare:workers";
import Setup from "../../components/auth/setup";
import AdminLayout from "../../layouts/AdminLayout.astro";

const token = Astro.url.searchParams.get("token") ?? "";
const valid = Boolean(env.SETUP_TOKEN) && token === env.SETUP_TOKEN;
---

<AdminLayout title="Installation">
    {
        valid ? (
            <>
                <h1 class="text-2xl font-semibold">Créer le compte propriétaire</h1>
                <p class="mt-2 text-sm text-muted-foreground">
                    Choisis ton mot de passe. Il est haché en base ; aucun secret à gérer.
                </p>
                <div class="mt-6">
                    <Setup client:only="react" token={token} email={env.OWNER_EMAIL ?? ""} />
                </div>
            </>
        ) : (
            <>
                <h1 class="text-2xl font-semibold">Lien invalide</h1>
                <p class="mt-2 text-sm text-muted-foreground">
                    Ce lien d'installation est incorrect ou a expiré.
                </p>
            </>
        )
    }
</AdminLayout>
