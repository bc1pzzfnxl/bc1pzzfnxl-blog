---
import ChangePassword from "../../components/auth/password";
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Mot de passe">
    <h1 class="text-2xl font-semibold">Changer le mot de passe</h1>
    <p class="mt-2 text-sm text-muted-foreground">
        Le nouveau mot de passe remplace l'ancien immédiatement, sans déconnexion.
    </p>
    <div class="mt-6">
        <ChangePassword client:only="react" />
    </div>
</AdminLayout>
