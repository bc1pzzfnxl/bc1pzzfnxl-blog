---
import MainLayout from "../layouts/MainLayout.astro";
import { Icon } from "astro-icon/components";

export const prerender = true;

export async function getStaticPaths() {
    const posts = import.meta.glob("../content/*.{md,mdx}", { eager: true });
    return Object.entries(posts).map(([path, post]) => {
        const slug = path.split("/").pop().replace(/\.(md|mdx)$/, "");
        return {
            params: { slug },
            props: { post },
        };
    });
}

const { post } = Astro.props;
const { Content, rawContent, frontmatter = {} } = post;

const slug = Astro.params.slug;
const title = frontmatter.title || decodeURIComponent(slug || "")
    .toLowerCase()
    .split("-")
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

const description = rawContent()
    .replace(/^---[\s\S]*?---\s*/m, '')
    .replace(/[#*`_\[\]>]/g, '')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\n+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .substring(0, 160) + "...";

const postUrl = frontmatter.url || new URL(Astro.url.pathname, Astro.site || "https://bc1pzzfnxl.com").href;
const postImage = frontmatter.image || "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c";

const schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": [postImage],
    "url": postUrl,
    "inLanguage": "fr",
    "author": {
        "@type": "Person",
        "name": frontmatter.author || "bc1pzzfnxl",
        "url": "https://bc1pzzfnxl.com",
        "image": "https://bc1pzzfnxl.com/logo.png"
    },
    "publisher": {
        "@type": "Person",
        "name": "bc1pzzfnxl",
        "url": "https://bc1pzzfnxl.com",
        "image": "https://bc1pzzfnxl.com/logo.png",
        "logo": {
            "@type": "ImageObject",
            "url": "https://bc1pzzfnxl.com/logo.png"
        }
    },
    "datePublished": frontmatter.date || "2026-07-03",
    "dateModified": frontmatter.dateModified || frontmatter.date || "2026-08-07",
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": postUrl
    }
};
const formatDate = (dateStr?: string) => {
    if (!dateStr) return "";
    const date = new Date(dateStr);
    return isNaN(date.getTime())
        ? dateStr
        : new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(date);
};

const publishDate = formatDate(frontmatter.date);
const modifiedDate = formatDate(frontmatter.dateModified);
---

<MainLayout title={title} description={description} ogType="article" image={postImage}>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <article>
        <h1>{title}</h1>
        {publishDate && (
            <div class="article-meta">
                <time datetime={frontmatter.date}>{publishDate}</time>
            </div>
        )}
        {frontmatter.image && (
            <figure class="article-cover-wrapper">
                <img
                    src={frontmatter.image}
                    alt={frontmatter.imageAlt || title}
                    class="article-cover"
                    width="680"
                    height="382"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
                {frontmatter.imageAlt && (
                    <figcaption class="article-cover-caption">{frontmatter.imageAlt}</figcaption>
                )}
            </figure>
        )}
        <Content components={{ Icon }} />
    </article>
    <div class="article-footer">
        <a href="/" class="back-link">← Retour</a>
        {modifiedDate && (
            <span class="modified-date">Modifié le {modifiedDate}</span>
        )}
    </div>
</MainLayout>