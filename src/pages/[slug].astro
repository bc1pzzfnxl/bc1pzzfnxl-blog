---
import { env } from "cloudflare:workers";
import { createContent } from "../content";
import MainLayout from "../layouts/MainLayout.astro";
import { absoluteUrl, blogPostingSchema, breadcrumbSchema } from "../lib/seo";
import { mediaKeysInHtml, mediaPublicPath, optimizeBodyImages } from "../lib/media";
import { site } from "../lib/site";

const content = createContent(env.DB);
const slug = Astro.params.slug ?? "";

const article = await content.getPublishedBySlug(slug);

if (!article) {
  const redirect = await content.getRedirect(Astro.url.pathname);
  if (redirect) {
    return Astro.redirect(redirect.toPath, 301);
  }
  Astro.response.status = 404;
}

const cover = article?.ogImageKey ? await content.getMediaByKey(article.ogImageKey) : null;

const dimensions = new Map<string, { width: number; height: number }>();
if (article) {
  for (const key of mediaKeysInHtml(article.bodyHtml)) {
    const media = await content.getMediaByKey(key);
    if (media?.width && media?.height) dimensions.set(key, { width: media.width, height: media.height });
  }
}

const title = article?.title ?? "Page introuvable";
const description = article?.description ?? "La page demandée n'existe pas ou a été déplacée.";
const url = absoluteUrl(site.url, `/${slug}/`);
const image = article?.ogImageKey
  ? absoluteUrl(site.url, mediaPublicPath(article.ogImageKey))
  : site.defaultCover;

const formatDate = (dateStr?: string | null) => {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return Number.isNaN(date.getTime())
    ? dateStr
    : new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(date);
};

const publishDate = formatDate(article?.publishedAt);
const modifiedDate = formatDate(article?.updatedAt);

const schemas = article
  ? [
      blogPostingSchema({
        title: article.title,
        description: article.description,
        url,
        image,
        locale: site.locale,
        publishedAt: article.publishedAt,
        modifiedAt: article.updatedAt,
        author: { name: site.author.name, url: site.author.url },
        publisher: { name: site.name, url: site.url, logo: site.logo },
      }),
      breadcrumbSchema(site, article.title, url),
    ]
  : [];
---

<MainLayout
    title={title}
    description={description}
    ogType={article ? "article" : "website"}
    image={image}
    publishedTime={article?.publishedAt ?? undefined}
    modifiedTime={article?.updatedAt ?? undefined}
>
    {schemas.map((schema) => <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />)}
    <article>
        {
            article ? (
                <>
                    <h1>{article.title}</h1>
                    {publishDate && (
                        <div class="article-meta">
                            <time datetime={article.publishedAt ?? undefined}>{publishDate}</time>
                        </div>
                    )}
                    {
                        article.ogImageKey && (
                            <figure class="article-cover-wrapper">
                                <img
                                    src={mediaPublicPath(article.ogImageKey)}
                                    alt={cover?.alt ?? article.title}
                                    class="article-cover"
                                    width={cover?.width ?? undefined}
                                    height={cover?.height ?? undefined}
                                    loading="eager"
                                    fetchpriority="high"
                                    decoding="async"
                                />
                                {cover?.alt && <figcaption class="article-cover-caption">{cover.alt}</figcaption>}
                            </figure>
                        )
                    }
                    <div class="article-body" data-reveal-article set:html={optimizeBodyImages(article.bodyHtml, dimensions)} />
                </>
            ) : (
                <>
                    <h1>Page introuvable</h1>
                    <p>La page demandée n'existe pas ou a été déplacée.</p>
                </>
            )
        }
    </article>
    <div class="article-footer">
        <a href="/" class="back-link">← Retour</a>
        {article && modifiedDate && <span class="modified-date">Modifié le {modifiedDate}</span>}
    </div>
</MainLayout>
