---
import fs from "node:fs";
import path from "node:path";
import sharp from "sharp";

interface Props {
  src: string;
  alt?: string;
  width?: number | string;
  height?: number | string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "auto" | "sync";
  [key: string]: any;
}

const {
  src,
  alt = "",
  width: propWidth,
  height: propHeight,
  loading = "lazy",
  decoding = "async",
  ...rest
} = Astro.props;

let width = propWidth;
let height = propHeight;

if ((!width || !height) && typeof src === "string" && src.startsWith("/")) {
  try {
    const publicPath = path.join(process.cwd(), "public", src.replace(/^\//, ""));
    if (fs.existsSync(publicPath)) {
      const metadata = await sharp(publicPath).metadata();
      if (metadata.width && metadata.height) {
        width = metadata.width;
        height = metadata.height;
      }
    }
  } catch (err) {
  }
}
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  {...rest}
/>
