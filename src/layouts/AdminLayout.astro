---
import "../styles/admin.css";
import Logout from "../components/auth/logout";
import { site } from "../lib/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} · {site.name}</title>
    </head>
    <body>
        <header class="border-b">
            <nav class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-6 py-4">
                <a href="/admin" class="font-medium">{site.name}</a>
                <div class="flex items-center gap-4">
                    <a href="/admin/password/" class="text-sm text-muted-foreground hover:underline">
                        Mot de passe
                    </a>
                    <Logout client:load />
                    <a href="/" target="_blank" rel="noreferrer" class="text-sm text-muted-foreground hover:underline">
                        Voir le site ↗
                    </a>
                </div>
            </nav>
        </header>
        <main class="mx-auto max-w-4xl px-6 py-10">
            <slot />
        </main>
    </body>
</html>
